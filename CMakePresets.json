{
  "version": 3,
  "configurePresets": [
    {
      "name": "win-release",
      "displayName": "Windows x64 (vcpkg on E:)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "E:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-release",
      "configurePreset": "win-release",
      "configuration": "Release"
    }
  ]
}
